# ============================================
# LocalConnect Environment Configuration
# ============================================

# Server Ports
BACKEND_PORT=3001
UI_PORT=3004
ADMIN_WEB_PORT=3002

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_DATABASE_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=localconnect
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DATABASE_NAME=localconnect

# Prisma Database URL (constructed from above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_DATABASE_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE_NAME}?schema=public

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET_KEY=your_super_secret_jwt_key_min_32_chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ============================================
# OTP Configuration
# ============================================
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
# OTP Provider: twilio, msg91, mock (for development)
OTP_PROVIDER=mock

# Twilio (if using)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# File Storage (S3)
# ============================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=localconnect-uploads

# Local storage fallback
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ============================================
# Map Services
# ============================================
# Provider: google, mapbox
MAP_PROVIDER=google
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_OTP_TTL=60
RATE_LIMIT_OTP_MAX=3

# ============================================
# Feature Flags
# ============================================
FEATURE_MONETIZATION_ENABLED=false
FEATURE_EXPERIMENTAL_ENABLED=false

# ============================================
# Logging & Monitoring
# ============================================
LOG_LEVEL=debug

# ============================================
# Application URLs
# ============================================
BACKEND_URL=http://localhost:${BACKEND_PORT}
FRONTEND_URL=http://localhost:${UI_PORT}
ADMIN_URL=http://localhost:${ADMIN_WEB_PORT}

# ============================================
# General
# ============================================
NODE_ENV=development
ENVIRONMENT=local
